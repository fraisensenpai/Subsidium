{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subsidium",
  "version": "0.1.4",
  "identifier": "com.subsidium.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Subsidium",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local workspace-intelligence coding agent by Crescendo Technologies",
    "longDescription": "Subsidium is a desktop coding environment built around your workspace: file explorer, editor, terminal, search, Git information and an approval-gated AI agent in one place. Made by Crescendo Technologies.",
    "publisher": "Crescendo Technologies",
    "copyright": "Copyright (c) 2026 Crescendo Technologies",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
